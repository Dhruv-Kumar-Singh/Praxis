# ==============================================================================
# Praxis Orchestrator Environment Configuration
# ==============================================================================

# Server configuration
PORT=8000
HOST=0.0.0.0
ENV=development
ORCHESTRATOR_INTERNAL_SECRET=change_me_to_a_secure_shared_secret

# MongoDB Connection
MONGODB_URI=mongodb://localhost:27017/praxis?replicaSet=rs0
MONGODB_DB_NAME=praxis

# LLM Gateway
LLM_PROVIDER=openai
OPENAI_API_KEY=your_openai_api_key_here
PRIMARY_MODEL=gpt-6.1-sol
FALLBACK_MODEL=gpt-6-luna
GUARD_MODEL=gpt-6-luna
EMBEDDING_MODEL=all-MiniLM-L6-v2

# LiveKit Configuration
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key_here
LIVEKIT_API_SECRET=your_livekit_api_secret_here

# STT / TTS / VAD
STT_PROVIDER=openai
TTS_PROVIDER=openai
VAD_PROVIDER=silero
