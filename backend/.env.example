NODE_ENV=development
PORT=4000
HOST=localhost

# JWT
JWT_SECRET=change_me_32_chars_minimum_secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
JWT_INTERVIEW_EXPIRES=5m

# Repository driver (memory | firebase)
REPO_DRIVER=firebase

# ── Firebase Realtime Database ─────────────────────────────────────────────────
FIREBASE_DATABASE_URL=https://praxis-b8ea5-default-rtdb.firebaseio.com/

# Paste the entire contents of your Firebase service-account JSON as a single
# line here (remove all newlines). Leave blank to use GOOGLE_APPLICATION_CREDENTIALS.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Provider selection
PROVIDER_STT=mock
PROVIDER_LLM=mock
PROVIDER_TTS=mock

# CORS allowlist (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Rate limits (requests per window)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
RATE_LIMIT_AUTH_MAX=10

# Max interview session duration in ms
SESSION_MAX_DURATION_MS=3600000
