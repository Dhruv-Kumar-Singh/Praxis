NODE_ENV=development
PORT=4000
HOST=localhost

# JWT Configuration
JWT_SECRET=praxis_jwt_super_secret_signing_key_32chars_min
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
JWT_INTERVIEW_EXPIRES=5m

# Repository Driver: mongo | memory | firebase
REPO_DRIVER=mongo

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/praxis
MONGODB_DB_NAME=praxis

# Orchestrator Internal Communication
ORCHESTRATOR_URL=http://127.0.0.1:8000
ORCHESTRATOR_INTERNAL_SECRET=praxis_internal_dev_secret_32char_minimum

# LiveKit Cloud (Required for live audio/video interview room)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# Provider selection
PROVIDER_STT=mock
PROVIDER_LLM=mock
PROVIDER_TTS=mock

# CORS allowlist (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:5174

# Rate limits
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
RATE_LIMIT_AUTH_MAX=10
SESSION_MAX_DURATION_MS=3600000
